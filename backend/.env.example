# Server
PORT=5000
NODE_ENV=development

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bus_pass_db
DB_USER=postgres
DB_PASSWORD=postgres

# On Railway/Heroku, a single connection string is provided automatically
# and takes priority over the individual DB_* vars above.
DATABASE_URL=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Maps (for the bus tracker page)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
